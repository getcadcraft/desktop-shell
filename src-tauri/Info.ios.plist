<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- SPDX-License-Identifier: Apache-2.0 -->
<!-- CadCraft Studio on iPad (docs/0.5-PART3.md TB.3, TB.5; STUDIO-LIVE-SPEC § 8, LV.13's iPad keys): merged by Tauri into the
     app's Info.plist. Studio Live finds and offers sessions on the local network with Bonjour (_ccstudio._tcp); iPadOS asks
     the person once. Files open in place from the Files app. Studio is an iPad app (no iPhone layout). -->
<plist version="1.0">
<dict>
  <key>NSLocalNetworkUsageDescription</key>
  <string>Studio Live finds and hosts shared drawings on your local network.</string>
  <key>NSBonjourServices</key>
  <array>
    <string>_ccstudio._tcp</string>
  </array>
  <key>LSSupportsOpeningDocumentsInPlace</key>
  <true/>
  <key>UIFileSharingEnabled</key>
  <false/>
  <key>UIRequiresFullScreen</key>
  <false/>
  <key>UISupportedInterfaceOrientations~ipad</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationPortraitUpsideDown</string>
    <string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string>
  </array>
</dict>
</plist>
