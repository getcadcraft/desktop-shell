{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CadCraft",
  "version": "0.4.0",
  "identifier": "com.getcadcraft.cadcraft",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "CadCraft",
    "copyright": "CadCraft contributors, Apache-2.0",
    "category": "Productivity",
    "shortDescription": "CadCraft",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  }
}
